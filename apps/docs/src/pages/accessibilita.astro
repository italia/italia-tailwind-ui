---
import Base from "../layouts/Base.astro";
import { Code } from "astro:components";

const run = `bunx playwright install --only-shell chromium   # una volta: il browser usato dai test
bun run a11y                                     # componenti: tutti i controlli, temi italia-*
bun run a11y --check axe,keyboard --component tabs,input
bun run a11y --theme italia-darker               # un tema (--all-themes: anche quelli daisyUI)
bun run a11y --update-snapshots                  # accetta le modifiche all'albero di accessibilità
bun run docs:build && bun run a11y:site          # pagine del sito, come pa11y-ci con runner axe
bun run a11y --json a11y-report.json --no-fail   # report JSON senza far fallire il comando`;

const checks = [
  {
    name: "axe",
    what: "Regole WCAG 2.2 A/AA di axe-core, il motore consigliato da Dev Kit Italia, su ogni esempio e in ogni tema: il contrasto cambia con il tema. Le «best practice» di axe (heading e label vuoti, landmark) sono avvisi.",
    wcag: "1.1.1, 1.3.1, 1.4.3, 2.4.4, 2.5.8, 4.1.2 e le altre regole automatiche",
  },
  {
    name: "tastiera",
    what: "Tab e Maiusc+Tab dall'inizio alla fine di ogni esempio: nessuna trappola, tutti i controlli visibili raggiungibili, il focus cambia l'aspetto dell'elemento e non resta coperto da altro contenuto.",
    wcag: "2.1.1, 2.1.2, 2.4.7, 2.4.11",
  },
  {
    name: "interazioni",
    what: "Scenari da tastiera per componente: Invio e Spazio aprono accordion e dropdown, Esc chiude modale e popover e il focus torna al pulsante, le frecce cambiano scheda, opzione e voto, un tooltip mostrato col focus si chiude con Esc.",
    wcag: "2.1.1, 2.4.3, 1.4.13, 3.3.1",
  },
  {
    name: "reflow",
    what: "A 320px di larghezza (1280px con zoom al 400%) niente scorrimento orizzontale, tranne dentro i contenitori fatti per scorrere. Con la spaziatura del testo WCAG (interlinea 1,5, spaziatura tra lettere e parole) nessun testo viene tagliato.",
    wcag: "1.4.10, 1.4.12",
  },
  {
    name: "html",
    what: "Validazione HTML con html-validate (preset standard e a11y): annidamenti non permessi, id duplicati, attributi non validi, regole di accessibilità del markup.",
    wcag: "4.1.1 (WCAG 2.1), 1.3.1",
  },
  {
    name: "aria",
    what: "Snapshot dell'albero di accessibilità di ogni esempio (ruoli, nomi, stati) in tests/a11y-snapshots/. Una modifica fa fallire il controllo finché non viene rivista e accettata.",
    wcag: "1.3.1, 4.1.2 (regressioni)",
  },
  {
    name: "sito",
    what: "Le pagine della documentazione intere: titolo, lingua, landmark, ordine dei titoli, link «Vai al contenuto» al primo Tab, reflow a 320px.",
    wcag: "2.4.1, 2.4.2, 3.1.1, 1.3.1, 1.4.10",
  },
];

const manual = [
  {
    title: "Tastiera",
    items: [
      "L'ordine del focus segue l'ordine di lettura della pagina.",
      "Il comportamento di ogni controllo è quello atteso (Invio sui link e pulsanti, Spazio su checkbox e radio, frecce nelle select e nei gruppi).",
      "Nessun contenuto compare o sparisce in modo inatteso quando un elemento riceve il focus.",
    ],
  },
  {
    title: "Lettori di schermo",
    items: [
      "Combinazione di riferimento del design system: Windows + Chrome + JAWS; in alternativa NVDA.",
      "Da verificare anche: macOS + Safari o Chrome + VoiceOver, iOS + Safari + VoiceOver, Android + Chrome + TalkBack.",
      "Ordine di lettura, etichette (anche nascoste e ARIA), struttura dei titoli, testi alternativi.",
      "Annuncio dei cambiamenti dinamici: notifiche, messaggi di errore, pannelli che si aprono.",
    ],
  },
  {
    title: "Zoom e visualizzazione",
    items: [
      "Zoom del browser al 400% su schermo largo 1280px: niente contenuti tagliati o sovrapposti.",
      "Elementi a scorrimento orizzontale (caroselli, tabelle) verificati a 1024px.",
      "Contrasto di stati che i tool non vedono: hover, focus, elementi sopra immagini.",
    ],
  },
  {
    title: "Per ogni variante di componente",
    items: [
      "Accessibilità visiva: contrasto e leggibilità.",
      "Compatibilità con i lettori di schermo: struttura ed etichette.",
      "Navigabilità: focus, struttura, tastiera.",
      "Comprensibilità: comportamento prevedibile, gestione degli errori.",
    ],
  },
];
---

<Base title="Accessibilità" description="Verifiche di accessibilità automatiche e manuali delle ricette">
  <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-base-content/60">Qualità</p>
  <h1 class="mb-4 text-4xl font-bold sm:text-5xl">Accessibilità</h1>
  <p class="mb-4 max-w-3xl text-lg text-base-content/85">
    Il riferimento è il <a href="https://designers.italia.it/design-system/fondamenti/accessibilita/">fondamento Accessibilità del design system .italia</a>:
    UNI CEI EN 301549:2021 e WCAG 2.1 livello AA, con WCAG 2.2. Le ricette sono HTML senza shadow DOM, quindi tutti i tool automatici le leggono per intero, senza i
    falsi positivi dei web component descritti nella <a href="https://italia.github.io/dev-kit-italia/?path=/docs/accessibilit%C3%A0--documentazione">guida di Dev Kit Italia</a>.
  </p>
  <p class="mb-10 max-w-3xl text-base-content/85">
    I controlli automatici trovano solo una parte dei problemi. Le verifiche manuali qui sotto restano necessarie, e per i servizi pubblici serve la valutazione di un
    esperto di accessibilità e, dove possibile, di utenti reali.
  </p>

  <h2 class="mb-4 text-3xl font-bold">Verifiche automatiche</h2>
  <p class="mb-4 max-w-3xl text-base-content/85">
    Ogni esempio documentato viene mostrato in Chromium headless con il CSS precompilato e controllato così. I risultati sono raggruppati per componente;
    il comando fallisce se ci sono errori, quindi si può usare in CI (<code class="font-mono">.github/workflows/a11y.yml</code>).
  </p>
  <div class="mb-6 overflow-x-auto rounded-box border border-base-content/15">
    <table class="table">
      <thead>
        <tr><th scope="col">Controllo</th><th scope="col">Cosa verifica</th><th scope="col">Criteri WCAG</th></tr>
      </thead>
      <tbody>
        {checks.map((c) => (
          <tr>
            <th scope="row" class="font-mono">{c.name}</th>
            <td>{c.what}</td>
            <td class="whitespace-nowrap text-sm">{c.wcag}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="mb-14 overflow-hidden rounded-box text-sm [&_pre]:p-4"><Code code={run} lang="sh" theme="github-dark" wrap /></div>

  <h2 class="mb-4 text-3xl font-bold">Verifiche manuali</h2>
  <p class="mb-6 max-w-3xl text-base-content/85">Dal fondamento Accessibilità di designers.italia.it, per ogni componente e ogni pagina che li usa:</p>
  <div class="mb-14 grid gap-6 md:grid-cols-2">
    {manual.map((m) => (
      <section class="rounded-box border border-base-content/15 p-5">
        <h3 class="mb-3 text-xl font-bold">{m.title}</h3>
        <ul class="list-disc space-y-2 ps-5">
          {m.items.map((i) => <li>{i}</li>)}
        </ul>
      </section>
    ))}
  </div>

  <h2 class="mb-4 text-3xl font-bold">Riferimenti</h2>
  <ul class="list-disc space-y-2 ps-5">
    <li><a href="https://designers.italia.it/design-system/fondamenti/accessibilita/">Fondamento Accessibilità, design system .italia</a></li>
    <li><a href="https://italia.github.io/dev-kit-italia/?path=/docs/accessibilit%C3%A0--documentazione">Accessibilità in Dev Kit Italia</a> e la sua <a href="https://italia.github.io/design-jekyll-devkit-theme/test-a11y/">pagina di test</a></li>
    <li><a href="https://www.w3.org/TR/WCAG22/">WCAG 2.2</a> · <a href="https://github.com/dequelabs/axe-core">axe-core</a> · <a href="https://html-validate.org/">html-validate</a> · <a href="https://playwright.dev/docs/aria-snapshots">snapshot ARIA di Playwright</a></li>
  </ul>
</Base>
