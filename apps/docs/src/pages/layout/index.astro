---
import Base from "../../layouts/Base.astro";
import { layouts } from "../../lib/layouts";
import { icon } from "@italia-tailwind/recipes";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const sourceUrl = (slug: string) =>
  `https://github.com/italia/italia-tailwind-ui/blob/main/apps/docs/src/pages/layout/${slug}.astro`;
---

<Base title="Layout" description="Pagine intere di esempio costruite con le classi ita-*, daisyUI e Tailwind">
  <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-base-content/60">Esempi</p>
  <h1 class="mb-4 text-4xl font-bold sm:text-5xl">Layout</h1>
  <p class="mb-10 max-w-3xl text-lg text-base-content/85">
    Pagine intere che mettono insieme i componenti: aprile a tutto schermo, ridimensiona la finestra e cambia tema.
    Il markup è HTML con classi ita-*, daisyUI e Tailwind, da copiare e adattare.
  </p>

  <div class="flex flex-col gap-14">
    {
      layouts.map((l) => (
        <section id={l.slug} class="scroll-mt-20">
          <h2 class="mb-1 text-2xl font-bold">{l.title}</h2>
          <p class="mb-3 max-w-3xl text-base-content/75">{l.description}</p>
          <div class="overflow-hidden rounded-box border border-base-content/15">
            {/* The page is rendered at desktop width and scaled down to fit (see the script below). */}
            <div class="relative aspect-[16/10] overflow-hidden bg-base-200" data-layout-preview>
              <iframe
                src={`${base}layout/${l.slug}/`}
                title={`Anteprima del layout ${l.title}`}
                loading="lazy"
                tabindex="-1"
                class="pointer-events-none absolute left-0 top-0 h-[900px] w-[1440px] origin-top-left border-0"
              />
            </div>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-base-content/15 bg-base-200 px-4 py-3">
              <a href={`${base}layout/${l.slug}/`} target="_blank" rel="noopener" class="ita-btn ita-btn-primary ita-btn-xs">
                <span>Apri a tutto schermo</span>
                <Fragment set:html={icon("it-external-link", "size-4")} />
                <span class="sr-only">(si apre in una nuova scheda)</span>
              </a>
              <a href={sourceUrl(l.slug)} class="link text-sm font-semibold text-base-content">
                Codice sorgente
              </a>
            </div>
          </div>
          {l.script && (
            <p class="mt-3 max-w-3xl text-sm text-base-content/75">
              <strong class="text-base-content">JavaScript:</strong> {l.script}
            </p>
          )}
        </section>
      ))
    }
  </div>

  <script is:inline>
    // Scale each 1440px-wide preview to the width of its frame.
    const fit = () =>
      document.querySelectorAll("[data-layout-preview]").forEach((box) => {
        box.querySelector("iframe").style.transform = `scale(${box.clientWidth / 1440})`;
      });
    fit();
    addEventListener("resize", fit);
  </script>
</Base>
