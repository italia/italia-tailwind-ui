---
import LayoutDemo from "../../layouts/LayoutDemo.astro";
---

<LayoutDemo title="Dashboard" bodyClass="bg-base-200 text-base-content antialiased">


  <!-- Skiplinks (design system) -->
  <nav aria-label="Scorciatoie di navigazione" class="ita-skiplinks">
    <a href="#main">Vai al contenuto principale</a>
    <a href="#sidebar-nav">Vai alla navigazione</a>
  </nav>

  <div class="flex h-dvh overflow-hidden">

    <!-- Backdrop (solo mobile) -->
    <div id="sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-neutral/50 lg:hidden" aria-hidden="true"></div>

    <!-- ============ SIDEBAR ============
         data-collapsed="true|false" → stato ridotto (solo ≥ lg)
         data-open="true|false"      → drawer aperto (solo < lg) -->
    <aside id="sidebar" data-collapsed="false" data-open="false" aria-label="Menu laterale"
      class="group/sb fixed inset-y-0 left-0 z-40 flex w-72 shrink-0 flex-col border-r border-base-300 bg-base-100
             transition-[width,translate] duration-200 ease-out
             max-lg:-translate-x-full max-lg:data-[open=true]:translate-x-0 max-lg:data-[open=true]:shadow-xl
             lg:relative lg:data-[collapsed=true]:w-20">

      <!-- Brand -->
      <div class="flex h-20 shrink-0 items-center gap-3 border-b border-base-300 px-4 lg:group-data-[collapsed=true]/sb:justify-center lg:group-data-[collapsed=true]/sb:px-0">
        <span class="ita-avatar ita-avatar-primary shrink-0">
          <span><svg class="size-6 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3,21h18v1H3V21z M3,20h18v-1H3V20z M22,9H2l10-7L22,9z M5.2,8h13.6L12,3.2L5.2,8z M6,18v-8H5v8H6z M10,18v-8H9v8H10z M15,18v-8h-1v8H15z M19,18v-8h-1v8H19z"/></svg><span class="sr-only">Logo dell'ente</span></span>
        </span>
        <div class="min-w-0 leading-tight lg:group-data-[collapsed=true]/sb:hidden">
          <p class="truncate font-bold">Nome dell'Istituzione</p>
          <p class="truncate text-sm text-base-content/70">Area riservata</p>
        </div>
        <button type="button" data-action="close-sidebar" class="btn btn-ghost btn-square btn-sm ms-auto lg:hidden" aria-label="Chiudi il menu">
          <svg class="size-5 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5.7,5l13.3,13.3l-0.7,0.7L5,5.7L5.7,5z M18.3,5L19,5.7L5.7,19L5,18.3L18.3,5z"/></svg>
        </button>
      </div>

      <!-- Spazio di lavoro (dropdown del design system) -->
      <div class="shrink-0 border-b border-base-300 p-4 lg:group-data-[collapsed=true]/sb:hidden">
        <details class="dropdown ita-dropdown w-full">
          <summary class="ita-btn ita-btn-primary ita-btn-outline w-full justify-between gap-2">
            <span class="flex min-w-0 items-center gap-2"><svg class="size-5 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12,13c2.2,0,4-1.8,4-4V6c0-2.2-1.8-4-4-4S8,3.8,8,6v3C8,11.2,9.8,13,12,13z M9,6c0-1.7,1.3-3,3-3s3,1.3,3,3v3 c0,1.7-1.3,3-3,3s-3-1.3-3-3V6z M20,22h-1c0-3.9-3.1-7-7-7s-7,3.1-7,7H4c0-4.4,3.6-8,8-8S20,17.6,20,22z"/></svg><span class="truncate">Personale</span></span>
            <svg class="ita-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 15.5 5.5 9 7 7.5l5 5 5-5L18.5 9z"/></svg>
          </summary>
          <ul class="dropdown-content menu ita-menu ita-menu-full">
            <li class="menu-title">Spazi di lavoro</li>
            <li><a href="#" aria-current="true"><span>Personale<span class="sr-only"> attivo</span></span></a></li>
            <li><a href="#"><span>Ufficio anagrafe</span></a></li>
            <li><a href="#"><span>Servizi digitali</span></a></li>
            <li role="separator"></li>
            <li><a href="#"><span>Crea uno spazio</span></a></li>
          </ul>
        </details>
      </div>

      <!-- Navigazione -->
      <nav id="sidebar-nav" tabindex="-1" aria-label="Navigazione principale" class="min-h-0 flex-1 overflow-y-auto overflow-x-hidden py-4 lg:group-data-[collapsed=true]/sb:overflow-visible">
        <ul class="menu w-full gap-1 px-3 text-base lg:group-data-[collapsed=true]/sb:items-center">
          <li class="menu-title lg:group-data-[collapsed=true]/sb:hidden">Gestione</li>
          <li>
            <a href="#" data-tip="Panoramica" class="gap-3 py-2.5 lg:group-data-[collapsed=true]/sb:tooltip lg:group-data-[collapsed=true]/sb:tooltip-right">
              <svg class="size-6 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12,2.6l10,8.2l-0.6,0.8L20,10.4V21h-6v-6h-4v6H4V10.4l-1.4,1.2L2,10.8L12,2.6z M5,9.6V20h4v-6h6v6h4V9.6l-7-5.7L5,9.6z"/></svg><span class="lg:group-data-[collapsed=true]/sb:sr-only">Panoramica</span>
            </a>
          </li>
          <li>
            <a href="#" data-tip="Area di prova" class="gap-3 py-2.5 lg:group-data-[collapsed=true]/sb:tooltip lg:group-data-[collapsed=true]/sb:tooltip-right">
              <svg class="size-6 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14.7,2H6.5C5.7,2,5,2.7,5,3.5v17C5,21.3,5.7,22,6.5,22h11c0.8,0,1.5-0.7,1.5-1.5V6.3L14.7,2z M15,3.7L17.3,6h-1.8 C15.2,6,15,5.8,15,5.5V3.7z M17.5,21h-11C6.2,21,6,20.8,6,20.5v-17C6,3.2,6.2,3,6.5,3H14v2.5C14,6.3,14.7,7,15.5,7H18v13.5 C18,20.8,17.8,21,17.5,21z M8,9h8v1H8V9z M8,11h8v1H8V11z M8,13h4v1H8V13z"/></svg><span class="lg:group-data-[collapsed=true]/sb:sr-only">Area di prova</span>
            </a>
          </li>
          <li>
            <a href="#" aria-current="page" data-tip="Casi d'uso" class="menu-active gap-3 py-2.5 font-semibold lg:group-data-[collapsed=true]/sb:tooltip lg:group-data-[collapsed=true]/sb:tooltip-right">
              <svg class="size-6 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12,4.9l1.5,4.6l0.2,0.7h5.7l-4,2.9l-0.6,0.4l0.2,0.7l1.5,4.7L12.6,16L12,15.6L11.4,16l-3.9,2.9L9,14.2l0.2-0.7l-0.6-0.4 l-4-2.9h5.7l0.2-0.7L12,4.9 M12,1.7L9.5,9.2H1.6L8,13.9l-2.4,7.6l6.4-4.7l6.4,4.7L16,13.9l6.4-4.7h-7.9L12,1.7z"/></svg><span class="lg:group-data-[collapsed=true]/sb:sr-only">Casi d'uso</span>
            </a>
          </li>
          <li>
            <a href="#" data-tip="Pagamenti" class="gap-3 py-2.5 lg:group-data-[collapsed=true]/sb:tooltip lg:group-data-[collapsed=true]/sb:tooltip-right">
              <svg class="size-6 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.5,5h-17C2.7,5,2,5.7,2,6.5v11C2,18.3,2.7,19,3.5,19h17c0.8,0,1.5-0.7,1.5-1.5v-11C22,5.7,21.3,5,20.5,5z M3,9h18v3H3V9 z M21,17.5c0,0.3-0.2,0.5-0.5,0.5h-17C3.2,18,3,17.8,3,17.5V13h18V17.5z M3,8V6.5C3,6.2,3.2,6,3.5,6h17C20.8,6,21,6.2,21,6.5V8H3z M8,15H4v-1h4V15z"/></svg><span class="lg:group-data-[collapsed=true]/sb:sr-only">Pagamenti</span>
            </a>
          </li>
          <li>
            <a href="#" data-tip="Impostazioni" class="gap-3 py-2.5 lg:group-data-[collapsed=true]/sb:tooltip lg:group-data-[collapsed=true]/sb:tooltip-right">
              <svg class="size-6 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12,7.5c-2.5,0-4.5,2-4.5,4.5s2,4.5,4.5,4.5s4.5-2,4.5-4.5S14.5,7.5,12,7.5z M12,15.5c-1.9,0-3.5-1.6-3.5-3.5 s1.6-3.5,3.5-3.5s3.5,1.6,3.5,3.5S13.9,15.5,12,15.5z M21.8,13.9c0.1-0.6,0.2-1.3,0.2-1.9c0-0.6-0.1-1.3-0.2-1.9l-2.1-0.3 c-0.2-0.6-0.4-1.2-0.7-1.7l1.3-1.7c-0.7-1.1-1.6-2-2.7-2.7L15.9,5l-1.7-0.7l-0.3-2.1L12,2l-1.9,0.2L9.8,4.3L8.1,5L6.4,3.7 c-1.1,0.7-2,1.6-2.7,2.7L5,8.1C4.7,8.6,4.5,9.2,4.3,9.8l-2.1,0.3C2.1,10.7,2,11.4,2,12c0,0.6,0.1,1.3,0.2,1.9l2.1,0.3 c0.2,0.6,0.4,1.2,0.7,1.7l-1.3,1.7c0.7,1.1,1.6,2,2.7,2.7L8.1,19l1.7,0.7l0.3,2.1L12,22l1.9-0.2l0.3-2.1l1.7-0.7l1.7,1.3 c1.1-0.7,2-1.6,2.7-2.7L19,15.9c0.3-0.5,0.5-1.1,0.7-1.7L21.8,13.9z M18.9,13.2l-0.2,0.7c-0.1,0.5-0.3,1-0.6,1.5L17.8,16l0.4,0.5 l0.8,1.1c-0.4,0.5-0.9,1-1.4,1.4l-1.1-0.8L16,17.8l-0.6,0.3c-0.5,0.3-1,0.5-1.5,0.6l-0.7,0.2v0.7L13,20.9h-2l-0.2-1.3v-0.7 l-0.7-0.2c-0.5-0.1-1-0.3-1.5-0.6L8,17.8l-0.5,0.4L6.4,19c-0.5-0.4-1-0.9-1.4-1.4l0.8-1.1L6.2,16l-0.3-0.6c-0.3-0.5-0.5-1-0.6-1.5 l-0.2-0.7H4.4L3.1,13C3,12.7,3,12.3,3,12c0-0.3,0-0.7,0.1-1l1.3-0.2h0.7l0.2-0.7c0.1-0.5,0.3-1,0.6-1.5L6.2,8L5.8,7.5L5,6.4L6.4,5 l1.1,0.8L8,6.2l0.6-0.3c0.5-0.3,1-0.5,1.5-0.6l0.7-0.2V4.4L11,3.1h2l0.2,1.3v0.7l0.7,0.2c0.5,0.1,1,0.3,1.5,0.6L16,6.2l0.5-0.4 L17.6,5c0.5,0.4,1,0.9,1.4,1.4l-0.8,1.1L17.8,8l0.3,0.6c0.3,0.5,0.5,1,0.6,1.5l0.2,0.7h0.7l1.3,0.2c0.1,0.3,0.1,0.7,0.1,1 c0,0.3,0,0.7-0.1,1l-1.3,0.2H18.9z"/></svg><span class="lg:group-data-[collapsed=true]/sb:sr-only">Impostazioni</span>
            </a>
          </li>

          <li class="menu-title mt-4 lg:group-data-[collapsed=true]/sb:hidden">Risorse</li>
          <li class="hidden lg:group-data-[collapsed=true]/sb:block" aria-hidden="true"><hr class="my-2 w-8 border-base-300 p-0"></li>
          <li>
            <a href="#" target="_blank" rel="noopener" data-tip="Documentazione" class="gap-3 py-2.5 lg:group-data-[collapsed=true]/sb:tooltip lg:group-data-[collapsed=true]/sb:tooltip-right">
              <svg class="size-6 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4,12c0.1,0.5-0.3,0.9-0.8,1c-0.1,0-0.1,0-0.2,0c-0.6,0-1-0.4-1-1s0.4-1,1-1c0.5-0.1,0.9,0.3,1,0.8C4,11.9,4,11.9,4,12z M3,4.5C2.5,4.4,2.1,4.8,2,5.3c0,0.1,0,0.1,0,0.2C1.9,6,2.3,6.4,2.8,6.5c0.1,0,0.1,0,0.2,0c0.5,0.1,0.9-0.3,1-0.8 c0-0.1,0-0.1,0-0.2c0.1-0.5-0.3-0.9-0.8-1C3.1,4.5,3.1,4.5,3,4.5z M3,17.5c-0.6,0-1,0.4-1,1s0.4,1,1,1s1-0.4,1-1S3.6,17.5,3,17.5z M6,5v1h16V5H6z M6,12.5h16v-1H6V12.5z M6,19h16v-1H6V19z"/></svg><span class="lg:group-data-[collapsed=true]/sb:sr-only">Documentazione</span>
              <span class="ms-auto lg:group-data-[collapsed=true]/sb:hidden"><svg class="size-4 opacity-60 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21,3v6h-1V4.7l-7.6,7.7l-0.8-0.8L19.3,4H15V3H21z M17,19.5c0,0.3-0.2,0.5-0.5,0.5h-12C4.2,20,4,19.8,4,19.5v-12 C4,7.2,4.2,7,4.5,7H12V6H4.5C3.7,6,3,6.7,3,7.5v12C3,20.3,3.7,21,4.5,21h12c0.8,0,1.5-0.7,1.5-1.5V12h-1V19.5z"/></svg></span><span class="sr-only">(si apre in una nuova scheda)</span>
            </a>
          </li>
          <li>
            <a href="#" target="_blank" rel="noopener" data-tip="Comunità" class="gap-3 py-2.5 lg:group-data-[collapsed=true]/sb:tooltip lg:group-data-[collapsed=true]/sb:tooltip-right">
              <svg class="size-6 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19,3H5C3.9,3,3,3.9,3,5v10c0,1.1,0.9,2,2,2h2v5.4l1.7-1.7l3.7-3.7H19c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M20,15 c0.1,0.5-0.3,0.9-0.8,1c-0.1,0-0.1,0-0.2,0h-7l-4,4v-4H5c-0.5,0.1-0.9-0.3-1-0.8c0-0.1,0-0.1,0-0.2V5C3.9,4.5,4.3,4.1,4.8,4 C4.9,4,4.9,4,5,4h14c0.5-0.1,0.9,0.3,1,0.8c0,0.1,0,0.1,0,0.2V15z M9,10c0.1,0.5-0.3,0.9-0.8,1c-0.1,0-0.1,0-0.2,0 c-0.5,0.1-0.9-0.3-1-0.8c0-0.1,0-0.1,0-0.2C6.9,9.5,7.3,9.1,7.8,9C7.9,9,7.9,9,8,9c0.5-0.1,0.9,0.3,1,0.8C9,9.9,9,9.9,9,10z M13,10 c0,0.6-0.4,1-1,1s-1-0.4-1-1s0.4-1,1-1S13,9.4,13,10z M17,10c0,0.6-0.4,1-1,1c-0.6,0-1-0.4-1-1s0.4-1,1-1C16.6,9,17,9.4,17,10z"/></svg><span class="lg:group-data-[collapsed=true]/sb:sr-only">Comunità</span>
              <span class="ms-auto lg:group-data-[collapsed=true]/sb:hidden"><svg class="size-4 opacity-60 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21,3v6h-1V4.7l-7.6,7.7l-0.8-0.8L19.3,4H15V3H21z M17,19.5c0,0.3-0.2,0.5-0.5,0.5h-12C4.2,20,4,19.8,4,19.5v-12 C4,7.2,4.2,7,4.5,7H12V6H4.5C3.7,6,3,6.7,3,7.5v12C3,20.3,3.7,21,4.5,21h12c0.8,0,1.5-0.7,1.5-1.5V12h-1V19.5z"/></svg></span><span class="sr-only">(si apre in una nuova scheda)</span>
            </a>
          </li>
        </ul>
      </nav>

      <!-- Riduci / espandi (solo desktop) -->
      <div class="hidden shrink-0 px-3 pb-2 lg:block">
        <button type="button" data-action="toggle-collapse" aria-controls="sidebar" aria-expanded="true"
          class="btn btn-ghost w-full justify-start gap-3 font-normal text-base-content/70 lg:group-data-[collapsed=true]/sb:justify-center lg:group-data-[collapsed=true]/sb:tooltip lg:group-data-[collapsed=true]/sb:tooltip-right"
          data-tip="Espandi il menu">
          <svg class="size-5 transition-transform lg:group-data-[collapsed=true]/sb:rotate-180 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 15.5 5.5 9 7 7.5l5 5 5-5L18.5 9z" transform="rotate(90 12 12)"/></svg>
          <span class="lg:group-data-[collapsed=true]/sb:sr-only" data-collapse-label>Riduci il menu</span>
        </button>
      </div>

      <!-- Utente (avatar + menu del design system) -->
      <div class="shrink-0 border-t border-base-300 p-3">
        <details class="dropdown dropdown-top ita-dropdown w-full">
          <summary class="ita-avatar-toggle w-full rounded-field p-1 text-base-content hover:bg-base-200 lg:group-data-[collapsed=true]/sb:justify-center">
            <span class="ita-avatar ita-avatar-sm ita-avatar-secondary shrink-0"><span><span aria-hidden="true">LP</span></span></span>
            <span class="min-w-0 flex-1 text-start leading-tight lg:group-data-[collapsed=true]/sb:sr-only">
              <span class="block truncate">Anon Imus</span>
              <span class="block truncate text-sm font-normal text-base-content/70">Amministratore</span>
            </span>
            <svg class="ita-chevron lg:group-data-[collapsed=true]/sb:hidden" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 15.5 5.5 9 7 7.5l5 5 5-5L18.5 9z"/></svg>
          </summary>
