  <script is:inline>
  (() => {
    const root = document.documentElement;
    const sidebar = document.getElementById('sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    const openBtn = document.querySelector('[data-action="open-sidebar"]');
    const collapseBtn = document.querySelector('[data-action="toggle-collapse"]');
    const collapseLabel = document.querySelector('[data-collapse-label]');
    const header = document.getElementById('page-header');
    const scroller = document.getElementById('scroller');
    const store = {
      get(k) { try { return localStorage.getItem(k); } catch { return null; } },
      set(k, v) { try { localStorage.setItem(k, v); } catch {} }
    };

    // Riduci / espandi (desktop)
    function setCollapsed(on) {
      sidebar.dataset.collapsed = String(on);
      collapseBtn.setAttribute('aria-expanded', String(!on));
      collapseLabel.textContent = on ? 'Espandi il menu' : 'Riduci il menu';
      sidebar.querySelectorAll('details[open]').forEach(d => d.open = false);
      store.set('sidebar-collapsed', on ? '1' : '0');
    }
    collapseBtn.addEventListener('click', () => setCollapsed(sidebar.dataset.collapsed !== 'true'));
    if (store.get('sidebar-collapsed') === '1') setCollapsed(true);

    // Drawer (mobile)
    function setOpen(on) {
      sidebar.dataset.open = String(on);
      backdrop.classList.toggle('hidden', !on);
      openBtn.setAttribute('aria-expanded', String(on));
      if (on) sidebar.querySelector('a, button, summary')?.focus();
      else openBtn.focus();
    }
    openBtn.addEventListener('click', () => setOpen(true));
    document.querySelector('[data-action="close-sidebar"]').addEventListener('click', () => setOpen(false));
    backdrop.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', e => {
      if (e.key !== 'Escape') return;
      const d = document.querySelector('details.dropdown[open]');
      if (d) { d.open = false; d.querySelector('summary').focus(); return; }
      if (sidebar.dataset.open === 'true') setOpen(false);
    });
    matchMedia('(min-width: 64rem)').addEventListener('change', e => { if (e.matches && sidebar.dataset.open === 'true') { sidebar.dataset.open = 'false'; backdrop.classList.add('hidden'); } });

    // Dropdown <details>: chiudi cliccando fuori e quando se ne apre un altro
    document.addEventListener('click', e => {
      document.querySelectorAll('details.dropdown[open]').forEach(d => { if (!d.contains(e.target)) d.open = false; });
    });

    // Ombra sull'intestazione quando il contenuto scorre sotto
    scroller.addEventListener('scroll', () => { header.dataset.stuck = String(scroller.scrollTop > 4); }, { passive: true });

    // Tema
    function setTheme(t) {
      root.dataset.theme = t;
      document.querySelectorAll('[data-set-theme]').forEach(b => {
        const on = b.dataset.setTheme === t;
        b.classList.toggle('menu-active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      store.set('italia-daisy-theme', t);
    }
    document.querySelectorAll('[data-set-theme]').forEach(b => b.addEventListener('click', () => {
      setTheme(b.dataset.setTheme); b.closest('details').open = false;
    }));
    setTheme(store.get('italia-daisy-theme') || root.dataset.theme);
  })();
  </script>
