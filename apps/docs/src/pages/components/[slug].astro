---
import { storyUrl } from "../../lib/storybook";
import Base from "../../layouts/Base.astro";
import Example from "../../components/Example.astro";
import { Code } from "astro:components";
import { components, type ComponentDoc } from "@italia-daisy/recipes";

export function getStaticPaths() {
  return components.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}
interface Props {
  doc: ComponentDoc;
}
const { doc } = Astro.props;
---

<Base title={doc.name} description={doc.summary}>
  <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-base-content/60">Componente</p>
  <h1 class="mb-4 text-4xl font-bold sm:text-5xl">{doc.name}</h1>
  <p class="mb-6 max-w-3xl text-lg text-base-content/85">{doc.summary}</p>

  <dl class="mb-10 grid gap-x-8 gap-y-3 rounded-box bg-base-200 p-5 text-sm sm:grid-cols-[max-content_1fr]">
    <dt class="font-semibold">Sostituisce</dt>
    <dd><code class="font-mono">{doc.replaces}</code></dd>
    {doc.classes?.length && (
      <>
        <dt class="font-semibold">Classi</dt>
        <dd class="flex flex-wrap gap-1.5">{doc.classes.map((c) => <code class="rounded-sm bg-primary/10 px-1.5 py-0.5 font-mono text-primary">{c}</code>)}</dd>
      </>
    )}
    {doc.daisy.length > 0 && (
      <>
        <dt class="font-semibold">{doc.classes?.length ? "Basato su (daisyUI)" : "Classi daisyUI"}</dt>
        <dd class="flex flex-wrap gap-1.5">{doc.daisy.map((c) => <code class="rounded-sm bg-base-100 px-1.5 py-0.5 font-mono">{c}</code>)}</dd>
      </>
    )}
    {doc.extensions?.length && (
      <>
        <dt class="font-semibold">Estensioni</dt>
        <dd class="flex flex-wrap gap-1.5">{doc.extensions.map((c) => <code class="rounded-sm bg-base-100 px-1.5 py-0.5 font-mono">{c}</code>)}</dd>
      </>
    )}
    {doc.cssOnly && (
      <>
        <dt class="font-semibold">Solo CSS</dt>
        <dd>{doc.cssOnly}</dd>
      </>
    )}
    <dt class="font-semibold">Storybook</dt>
    <dd><a href={storyUrl(doc.slug)}>Apri le storie di {doc.name}</a></dd>
  </dl>

  <nav aria-label="Esempi" class="mb-10">
    <ul class="flex flex-wrap gap-2">
      {doc.examples.map((ex) => <li><a href={`#${ex.id}`} class="badge badge-lg badge-outline border-base-content/25 font-semibold hover:bg-base-200">{ex.title}</a></li>)}
      {doc.snippets?.length && <li><a href="#javascript" class="badge badge-lg badge-outline border-primary/40 font-semibold text-primary hover:bg-base-200">Con JavaScript</a></li>}
    </ul>
  </nav>

  <div class="flex flex-col gap-14">
    {doc.examples.map((ex) => <Example example={ex} />)}
  </div>

  {doc.snippets?.length && (
    <section id="javascript" class="mt-16 scroll-mt-20">
      <h2 class="mb-1 text-2xl font-bold">Con JavaScript (opzionale)</h2>
      <p class="mb-6 max-w-3xl text-base-content/75">
        La ricetta è solo CSS e funziona così com'è. Questi frammenti non sono inclusi nel pacchetto: mostrano come aggiungere
        il comportamento che richiede uno script, in JavaScript semplice o in React.
      </p>
      <div class="flex flex-col gap-8">
        {doc.snippets.map((s) => (
          <div>
            <h3 class="mb-1 flex items-center gap-2 text-lg font-bold">
              {s.title}
              <span class="badge badge-sm badge-outline border-base-content/25 font-mono">{s.lang}</span>
            </h3>
            {s.description && <p class="mb-2 text-base-content/75">{s.description}</p>}
            <div class="max-h-[32rem] overflow-auto rounded-box text-sm [&_pre]:p-4"><Code code={s.code.trim()} lang={s.lang} theme="github-dark" /></div>
          </div>
        ))}
      </div>
    </section>
  )}
</Base>
