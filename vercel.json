{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "docs": {
      "root": "apps/docs",
      "framework": "astro"
    },
    "storybook": {
      "root": "apps/storybook",
      "framework": "vite",
      "outputDirectory": "storybook-static"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": { "pre": "storybook." } }],
      "destination": {
        "service": "storybook"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "docs"
      }
    }
  ]
}
