{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "docs": {
      "root": "apps/docs",
      "framework": "astro"
    },
    "storybook": {
      "root": "apps/storybook",
      "framework": "vite",
      "outputDirectory": "storybook-static"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "docs"
      }
    }
  ]
}
