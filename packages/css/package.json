{
  "name": "@italia-tailwind/css",
  "version": "0.1.0",
  "description": "daisyUI 5 themes and a thin extension layer that give Tailwind CSS 4 the look of the .italia design system",
  "license": "BSD-3-Clause",
  "keywords": [
    "italia",
    "design-system",
    "daisyui",
    "tailwindcss",
    "bootstrap-italia",
    "dev-kit-italia",
    "css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/italia/italia-tailwind-ui.git",
    "directory": "packages/css"
  },
  "homepage": "https://italia-tailwind-ui.vercel.app/docs/",
  "bugs": "https://github.com/italia/italia-tailwind-ui/issues",
  "type": "module",
  "style": "./src/index.css",
  "exports": {
    ".": "./src/index.css",
    "./index.css": "./src/index.css",
    "./themes.css": "./src/themes.css",
    "./base.css": "./src/base.css",
    "./extensions.css": "./src/extensions.css",
    "./dist/italia-tailwind.css": "./dist/italia-tailwind.css",
    "./fonts.css": "./src/fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "tailwindcss -i ./src/standalone.css -o ./dist/italia-tailwind.css --minify",
    "prepack": "bun run build && cp ../../LICENSE LICENSE"
  },
  "peerDependencies": {
    "daisyui": "^5.7.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.42",
    "tailwindcss": "^4.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
